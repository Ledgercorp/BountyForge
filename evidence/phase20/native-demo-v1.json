        "revision": 0,
        "source": "def weighted_mix(pairs):\n    pairs = list(pairs)\n    numerator = sum(value * weight for value, weight in pairs)\n    denominator = len(pairs)\n    if not denominator:\n        return 0.0\n    return numerator / denominator\n",
