              "content": "{\"description\":\"Release reserved units only for settled events, once per event ID. Pending, cancelled and missing statuses are ignored without recording the ID. Clamp each accepted release to held units. Accumulate released units from the existing state; invalid amounts contribute zero. Return sorted seen IDs without mutating inputs.\",\"failure_feedback\":{\"failing_tests\":[\"test_clamp_and_duplicates\",\"test_invalid_amount_preserves_balance\",\"test_missing_status_ignored\",\"test_pending_can_later_settle\",\"test_settled_accumulates\"],\"assertions\":[\"AssertionError: {'held': 0, 'released': 3, 'seen': ['a']} != {'held': 0, 'released': 8, 'seen': ['a']}\",\"AssertionError: {'held': 10, 'released': 0, 'seen': ['a']} != {'held': 10, 'released': 7, 'seen': ['a']}\",\"AssertionError: {'held': 6, 'released': 3, 'seen': ['a']} != {'held': 9, 'released': 4, 'seen': []}\"],\"classification\":\"OWNED_DEVELOPMENT_FEEDBACK\",\"unseen_evaluation\":false},\"revision_strategy\":\"INITIAL_MINIMAL_REPAIR\",\"target_symbol\":\"apply_release\",\"source\":\"def release_amount(event):\\n    amount = event.get('amount', 0)\\n    return amount if type(amount) is int and amount > 0 else 0\\n\\n\\ndef apply_release(state, events):\\n    held = state['held']\\n    released = state['released']\\n    seen = set(state['seen'])\\n    for event in events:\\n        if event['id'] in seen:\\n            continue\\n        if event.get('status') == 'cancelled':\\n            continue\\n        amount = min(held, release_amount(event))\\n        held -= amount\\n        released = amount\\n        seen.add(event['id'])\\n    return {'held': held, 'released': released, 'seen': sorted(seen)}\\n\",\"edit_units\":[{\"line\":17,\"end_line\":17,\"kind\":\"statement\"},{\"line\":9,\"end_line\":9,\"kind\":\"statement\"},{\"line\":8,\"end_line\":8,\"kind\":\"statement\"},{\"line\":7,\"end_line\":7,\"kind\":\"statement\"},{\"line\":15,\"end_line\":15,\"kind\":\"statement\"}