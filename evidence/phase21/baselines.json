      "revision": 0,
      "source": "def parse_pairs(text):\n    result = {}\n    for item in text.split(\";\"):\n        parts = item.split(\"=\")\n        if len(parts) < 2:\n            continue\n        key = parts[0].strip()\n        value = parts[-1].strip()\n        if not key:\n            continue\n        result[key] = value\n    return result\n",
