    "source": "def stock_delta(row):\n    value = row.get(\"delta\", 0)\n    return value if type(value) is int else 0\n\n\ndef reconcile_inventory(stock, rows):\n    updated = dict(stock)\n    for row in rows:\n        if row.get(\"approved\") is False:\n            continue\n        sku = row[\"sku\"]\n        updated[sku] = max(0, stock.get(sku, 0) + stock_delta(row))\n    return updated\n",
