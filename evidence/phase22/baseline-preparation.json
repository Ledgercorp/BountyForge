        "source": "def copy_record(row):\n    return dict(row)\n\n\ndef latest_records(rows):\n    result = {}\n    for row in rows:\n        if not row.get(\"id\"):\n            continue\n        key = row[\"id\"]\n        previous = result.get(key)\n        if previous is None or row[\"version\"] < previous[\"version\"]:\n            result[key] = copy_record(row)\n    return result\n",
