    {
      "case_id": "lease_capacity",
      "task": {
        "case_id": "lease_capacity",
        "task_id": "1df97079f9e945f0a15e0e558a89f04b",
        "revision": 0,
        "engine": "CODEX_AGENT",
        "source": "def fits(used, units, capacity):\n    return used + units <= capacity\n\n\ndef apply_events(state, events, capacity):\n    result = dict(state)\n    seen = set(state[\"seen\"])\n    used = state[\"used\"]\n    accepted = 0\n    for event in events:\n        if event[\"id\"] in seen:\n            continue\n        units = event[\"units\"]\n        if event[\"kind\"] == \"acquire\" and fits(used, units, capacity):\n            used += units\n        elif event[\"kind\"] == \"release\" and used > units:\n            used = state[\"used\"] - units\n        else:\n            continue\n        seen.add(event[\"id\"])\n        accepted += 1\n    result.update(used=used, seen=seen, accepted=accepted)\n    return result\n",
        "source_sha256": "fef33d7c6086fe0c9fe9f6e870b82452381d6340a71282424842357cc799a058",
        "tests_sha256": "148db1adfd1e59af540ed353d7d27a0f49699643c9b0e208ace2ab2981d1565e",
        "target_symbol": "apply_events",
        "description": "Process ordered capacity events on a copied state. Ignore already seen event IDs. Accept acquire only when units fits remaining capacity, including exact fit; accept release only when units fits current usage. Every accepted event changes latest usage, records its ID, and increments accepted count. Rejected events are not recorded. Inputs have positive integer units. Preserve caller state, events and helper behavior.",
