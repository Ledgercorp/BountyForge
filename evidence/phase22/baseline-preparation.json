      "case_id": "retry_state",
      "task": {
        "case_id": "retry_state",
        "task_id": "2c7d84e0d5c346eb82c9e799292a49db",
        "revision": 0,
        "engine": "CODEX_AGENT",
        "source": "def terminal(status):\n    return status == \"cancelled\"\n\n\ndef after_failure(job, limit, base_delay):\n    result = dict(job)\n    if terminal(job[\"status\"]):\n        return result\n    attempts = job[\"attempts\"] + 1\n    exhausted = attempts > limit\n    delay = base_delay * max(1, attempts)\n    result.update(attempts=attempts, status=\"failed\" if exhausted else \"retrying\", delay=0 if exhausted else delay)\n    return result\n",
        "source_sha256": "7308cb1eb74206009e62526e31ad65253d23b56fd16233eecc72be90e9b26981",
        "tests_sha256": "19e5cb77c1cd7967713b919d5d8d501375bca093297556afc65ae11591e4e060",
        "target_symbol": "after_failure",
        "description": "Copy job state after one failure. Cancelled jobs remain unchanged. Increment attempts once; mark failed when attempts reaches the positive limit, otherwise retrying. Retrying delay is base_delay times 2 to the power attempts-minus-one; terminal delay is zero. Preserve caller state.",
