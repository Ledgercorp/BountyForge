        "engine": "CODEX_AGENT",
        "source": "def copy_items(items):\n    return list(items)\n\n\ndef apply_response(cache, response):\n    result = dict(cache)\n    status = response[\"status\"]\n    if status == 200:\n        payload = response[\"body\"]\n        result[\"items\"] = copy_items(payload.get(\"items\") or cache[\"items\"])\n        result[\"cursor\"] = payload.get(\"cursor\", cache[\"cursor\"])\n    elif status == 204:\n        result[\"items\"] = copy_items(cache[\"items\"])\n        result[\"cursor\"] = None\n    return result\n",
        "source_sha256": "00592fa7cbe0191749df1e57563e3da1bd1fbdfcff9dd7b5fc022ad1811ac617",
